<%- include('./header.ejs') %>
    <%- include('./sidebar.ejs') %>
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0 text-dark">Course</h1>
                        </div><!-- /.col -->
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                                <li class="breadcrumb-item active">Course Display</li>
                            </ol>
                        </div><!-- /.col -->
                    </div><!-- /.row -->
                </div><!-- /.container-fluid -->
            </div>
            <!-- /.content-header -->

            <!-- Main content -->
            <div class="content">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Courses Data with default features</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                            <table id="example1" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>courseName</th>
                                        <th>courseImage</th>
                                        <th>coursePrize</th>
                                        <th>teacherName</th>
                                        <th>expYear</th>
                                        <th>teacherImage</th>
                                        <th>numOfLesson</th>
                                        <th>courseDuration</th>
                                        <th>courseLevel</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <%= c.id %>
                                        </td>
                                        <td>
                                            <%= c.courseName %>
                                        </td>
                                        <td style="display: flex; align-items: center; justify-content: center;">
                                            <img src="<%= c.courseImage.url_1%>" alt="" height="50px" width="50px"
                                                style="border-radius: 50%;">
                                        </td>
                                        <td>
                                            &#8377;<%= c.coursePrize %>
                                        </td>

                                        <td>
                                            <%= c.teacherName %>
                                        </td>
                                        <td>
                                            <%= c.expYear %>
                                        </td>
                                        <td style="display: flex; align-items: center; justify-content: center;">
                                            <img src="<%= c.teacherImage.url_2%>" alt="" height="50px" width="50px"
                                                style="border-radius: 50%;">
                                        </td>
                                        <td>
                                            <%= c.numOfLesson %>
                                        </td>
                                        <td>
                                            <%= c.courseDuration %>
                                        </td>
                                        <td>
                                            <%= c.courseLevel %>
                                        </td>
                                        <td>
                                            <!-- <a href="/admin/viewCourse/<%= c.id %>" class="btn btn-primary">View</a> -->
                                            <a href="/admin/editCourse/<%= c.id %>" class="btn btn-info">Edit</a>
                                            <a href="/admin/deleteCourse/<%= c.id %>" class="btn btn-danger">Delete</a>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>ID</th>
                                        <th>courseName</th>
                                        <th>courseImage</th>
                                        <th>coursePrize</th>
                                        <th>teacherName</th>
                                        <th>expYear</th>
                                        <th>teacherImage</th>
                                        <th>numOfLesson</th>
                                        <th>courseDuration</th>
                                        <th>courseLevel</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div><!-- /.container-fluid -->
            </div>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <%- include('./footer.ejs') %>