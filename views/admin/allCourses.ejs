<%- include('./header.ejs') %>
    <%- include('./sidebar.ejs') %>
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0 text-dark">Course</h1>
                        </div><!-- /.col -->
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                                <li class="breadcrumb-item active">Course Display</li>
                            </ol>
                        </div><!-- /.col -->
                    </div><!-- /.row -->
                </div><!-- /.container-fluid -->
            </div>
            <!-- /.content-header -->

            <!-- Main content -->
            <div class="content">
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">DataTable with default features</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                            <table id="example1" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>S.No</th>
                                        <th>courseName</th>
                                        <th>courseImage</th>
                                        <th>coursePrize</th>
                                        <th>teacherName</th>
                                        <th>expYear</th>
                                        <th>teacherImage</th>
                                        <th>numOfLesson</th>
                                        <th>courseDuration</th>
                                        <th>courseLevel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% c.forEach((item,index)=>{ %>
                                        <tr>
                                            <td>
                                                <%= index+1 %>
                                            </td>
                                            <td>
                                                <%= item.courseName %>
                                            </td>
                                            <td style="display: flex; align-items: center; justify-content: center;">
                                                <img src="<%= item.courseImage.url_1%>" alt="" height="50px"
                                                    width="50px" style="border-radius: 50%;">
                                            </td>
                                            <td>
                                                <%= item.coursePrize %>
                                            </td>

                                            <td>
                                                <%= item.teacherName %>
                                            </td>
                                            <td>
                                                <%= item.expYear %>
                                            </td>
                                            <td style="display: flex; align-items: center; justify-content: center;">
                                                <img src="<%= item.teacherImage.url_2%>" alt="" height="50px"
                                                    width="50px" style="border-radius: 50%;">
                                            </td>
                                            <td>
                                                <%= item.numOfLesson %>
                                            </td>
                                            <td>
                                                <%= item.courseDuration %>
                                            </td>
                                            <td>
                                                <%= item.courseLevel %>
                                            </td>
                                            <td>
                                                <a href="/admin/courseView/<%= item.id %>"
                                                    class="btn btn-primary">View</a>
                                                <a href="/admin/courseEdit/<%= item.id %>" class="btn btn-info">Edit</a>
                                                <a href="/admin/courseDelete/<%= item.id %>"
                                                    class="btn btn-danger">Delete</a>
                                            </td>
                                        </tr>

                                        <% }) %>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>S.No</th>
                                        <th>courseName</th>
                                        <th>courseImage</th>
                                        <th>coursePrize</th>
                                        <th>teacherName</th>
                                        <th>expYear</th>
                                        <th>teacherImage</th>
                                        <th>numOfLesson</th>
                                        <th>courseDuration</th>
                                        <th>courseLevel</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div><!-- /.container-fluid -->
            </div>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <%- include('./footer.ejs') %>