<%- include('./header.ejs') %>
    <%- include('./sidebar.ejs')%>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <div class="content-header">

                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0 text-dark">New Course</h1>
                        </div><!-- /.col -->
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                                <li class="breadcrumb-item active">Security</li>
                            </ol>
                        </div><!-- /.col -->
                    </div><!-- /.row -->
                </div><!-- /.container-fluid -->


                <div class="container-fluid">

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">course Details</h3>
                            <% if(msg.length>0){%>
                                <div class="alert alert-danger text-center">
                                    <%= msg %>
                                </div>
                                <%}%>

                                    <% if(msg1.length>0){%>
                                        <div class="alert alert-success text-center">
                                            <%= msg1 %>
                                        </div>
                                        <%}%>

                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                            <table id="example1" class="table table-bordered table-striped">

                                <form action="/admin/addNewCourse" method="post" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="">Course Name</label>
                                        <input type="text" name="courseName" placeholder="web Devlopment"
                                            class="form-control">
                                    </div>
                                    <div class="mb-3">
                                        <label for="">Course Prize</label>
                                        <input type="text" name="coursePrize" placeholder="399" class="form-control">
                                    </div>
                                    <div class="mb-3">
                                        <label for="">Teacher Name</label>
                                        <input type="text" name="teacherName" placeholder="Vikas Jain"
                                            class="form-control">
                                    </div>
                                    <div class="mb-3">
                                        <label for="">Course Image</label>
                                        <input type="file" name="courseImage" class="form-control">
                                    </div>
                                    <div class="mb-3">
                                        <label for="">No. of Lessons</label>
                                        <input type="number" name="numOfLesson" placeholder="45" class="form-control">
                                    </div>
                                    <div class="mb-3">
                                        <label for="">Course Duration</label>
                                        <input type="text" name="courseDuration" placeholder="38h,45min"
                                            class="form-control">
                                    </div>
                                    <div class="mb-3">
                                        <label for="">Experience Years</label>
                                        <input type="text" name="expYear" placeholder="2" class="form-control">
                                    </div>
                                    <button type="submit" class="btn btn-success text-white">Add Course</button>

                                </form>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div><!-- /.container -->
            </div>
            <!-- /.content-header -->


        </div>
        <!-- /.content-wrapper -->




        <%- include('./footer.ejs') %>